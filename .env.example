# =============================================================
# Hughes Farms — environment variables
# =============================================================
# Copy this file to `.env.local` and fill in real values for local
# development.  Production / preview values live in the Vercel
# dashboard (Project → Settings → Environment Variables).
# -------------------------------------------------------------

# Postgres — Neon (pooled connection, ssl required)
DATABASE_URL=postgresql://USER:PASS@HOST/DBNAME?sslmode=require

# NextAuth v4
#   Full https URL of the deployed site. Used for callback URLs.
NEXTAUTH_URL=https://farm-management-dashboard.vercel.app
#   32+ random bytes. Rotate on any security incident.
#   Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-openssl-rand-base64-32

# One-time admin bootstrap. Required only when initializing a blank system.
SETUP_ADMIN_EMAIL=admin@example.com
SETUP_ADMIN_PASSWORD=replace-me-with-a-long-random-password
SETUP_FARM_NAME=Default Farm
# Optional API bootstrap token for POST /api/setup/admin.
SETUP_ADMIN_TOKEN=replace-me-with-openssl-rand-base64-32
